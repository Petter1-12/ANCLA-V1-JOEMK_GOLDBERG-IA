-- Función para cerrar con animación de 1.5 segundos
local function CerrarPantalla()
    local TiempoAnimacion = 1.5

    local TweenInfo = TweenInfo.new(
        TiempoAnimacion,
        Enum.EasingStyle.Sine,
        Enum.EasingDirection.Out
    )

    TweenService:Create(FondoTransparente, TweenInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(CuadroMensaje, TweenInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(TextoMensaje, TweenInfo, {TextTransparency = 1}):Play()
    TweenService:Create(BotonCerrar, TweenInfo, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(TextoFirma, TweenInfo, {TextTransparency = 1}):Play()

    task.wait(TiempoAnimacion)
    PantallaCarga:Destroy()
end

-- Conectar botón de cierre
BotonCerrar.MouseButton1Click:Connect(CerrarPantalla)
